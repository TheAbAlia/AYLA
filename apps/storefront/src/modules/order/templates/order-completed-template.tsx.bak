import { cookies as nextCookies } from "next/headers"
import { HttpTypes } from "@medusajs/types"

import { convertToLocale } from "@lib/util/money"
import { getAylaProductImages } from "@lib/util/ayla-product-images"
import LocalizedClientLink from "@modules/common/components/localized-client-link"
import OnboardingCta from "@modules/order/components/onboarding-cta"

type OrderCompletedTemplateProps = {
  order: HttpTypes.StoreOrder
}

const money = (
  amount: number | null | undefined,
  currencyCode: string
) =>
  convertToLocale({
    amount: amount ?? 0,
    currency_code: currencyCode,
  })

const formatDate = (date: string | Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(new Date(date))

export default async function OrderCompletedTemplate({
  order,
}: OrderCompletedTemplateProps) {
  const cookies = await nextCookies()
  const isOnboarding =
    cookies.get("_medusa_onboarding")?.value === "true"

  const itemCount =
    order.items?.reduce(
      (total, item) => total + item.quantity,
      0
    ) ?? 0

  const shippingMethod = order.shipping_methods?.[0]

  return (
    <main
      className="min-h-screen bg-[#EEEAE1] text-[#191816]"
      data-testid="order-complete-container"
    >
      <div className="px-5 pb-24 pt-10 md:px-[4.7%] md:pb-36 md:pt-14">
        {isOnboarding && (
          <div className="mb-10">
            <OnboardingCta orderId={order.id} />
          </div>
        )}

        {/* META */}
        <div className="flex items-center justify-between border-t border-[#191816]/25 pt-4">
          <span className="text-[8px] uppercase tracking-[0.28em] opacity-45">
            AYLA / Order confirmed
          </span>

          <span className="text-[8px] uppercase tracking-[0.28em] opacity-45">
            001
          </span>
        </div>

        {/* HERO */}
        <section className="mt-16 grid grid-cols-1 gap-12 md:mt-24 md:grid-cols-12">
          <div className="md:col-span-8">
            <p className="mb-6 text-[8px] uppercase tracking-[0.28em] opacity-45">
              Order received
            </p>

            <h1 className="font-serif text-[clamp(86px,13vw,220px)] font-normal uppercase leading-[0.68] tracking-[-0.065em]">
              Thank
              <br />
              you.
            </h1>
          </div>

          <div className="flex flex-col justify-end md:col-span-4 md:pb-2">
            <p className="max-w-[330px] text-[9px] uppercase leading-[1.8] tracking-[0.17em]">
              Your order has been received.
            </p>

            <p className="mt-5 max-w-[360px] text-[8px] uppercase leading-[1.8] tracking-[0.15em] opacity-45">
              Confirmation details have been sent to{" "}
              <span
                className="normal-case tracking-normal"
                data-testid="order-email"
              >
                {order.email}
              </span>
              .
            </p>
          </div>
        </section>

        {/* ORDER META */}
        <section className="mt-20 border-y border-[#191816]/25 py-5 md:mt-28">
          <div className="grid grid-cols-2 gap-8 md:grid-cols-4">
            <div>
              <p className="text-[7px] uppercase tracking-[0.24em] opacity-35">
                Order
              </p>
              <p
                className="mt-3 text-[9px] uppercase tracking-[0.18em]"
                data-testid="order-id"
              >
                {String(order.display_id).padStart(4, "0")}
              </p>
            </div>

            <div>
              <p className="text-[7px] uppercase tracking-[0.24em] opacity-35">
                Date
              </p>
              <p
                className="mt-3 text-[9px] uppercase tracking-[0.18em]"
                data-testid="order-date"
              >
                {formatDate(order.created_at)}
              </p>
            </div>

            <div>
              <p className="text-[7px] uppercase tracking-[0.24em] opacity-35">
                Items
              </p>
              <p className="mt-3 text-[9px] uppercase tracking-[0.18em]">
                {String(itemCount).padStart(2, "0")}
              </p>
            </div>

            <div>
              <p className="text-[7px] uppercase tracking-[0.24em] opacity-35">
                Total
              </p>
              <p className="mt-3 text-[9px] uppercase tracking-[0.18em]">
                {money(order.total, order.currency_code)}
              </p>
            </div>
          </div>
        </section>

        {/* ORDER */}
        <section className="mt-20 md:mt-28">
          <div className="flex items-end justify-between border-b border-[#191816]/25 pb-5">
            <div>
              <p className="mb-3 text-[8px] uppercase tracking-[0.26em] opacity-40">
                Your order
              </p>

              <h2 className="font-serif text-[40px] font-normal leading-none tracking-[-0.04em] md:text-[54px]">
                Summary
              </h2>
            </div>

            <span className="text-[8px] uppercase tracking-[0.22em] opacity-40">
              {String(itemCount).padStart(2, "0")}{" "}
              {itemCount === 1 ? "item" : "items"}
            </span>
          </div>

          <div>
            {order.items?.map((item) => {
              const handle =
                item.product_handle ||
                item.product?.handle ||
                null

              const aylaImages =
                getAylaProductImages(handle)

              const image =
                aylaImages?.front ||
                item.thumbnail ||
                undefined

              const size =
                item.variant?.options?.find(
                  (option) =>
                    option.option?.title?.toLowerCase() ===
                    "size"
                )?.value ||
                item.variant_title ||
                ""

              return (
                <div
                  key={item.id}
                  className="grid grid-cols-[72px_1fr_auto] gap-5 border-b border-[#191816]/15 py-6 md:grid-cols-[84px_1fr_auto] md:gap-7 md:py-7"
                >
                  <div className="aspect-[4/5] overflow-hidden bg-[#E4DFD5]">
                    {image ? (
                      <img
                        src={image}
                        alt={item.product_title || item.title}
                        className="h-full w-full object-cover"
                      />
                    ) : (
                      <div className="h-full w-full bg-[#E4DFD5]" />
                    )}
                  </div>

                  <div className="flex flex-col justify-center">
                    <p className="text-[9px] uppercase tracking-[0.19em]">
                      {item.product_title || item.title}
                    </p>

                    {size && (
                      <p className="mt-3 text-[7px] uppercase tracking-[0.2em] opacity-40">
                        Size {size}
                      </p>
                    )}

                    <p className="mt-2 text-[7px] uppercase tracking-[0.2em] opacity-40">
                      Quantity {String(item.quantity).padStart(2, "0")}
                    </p>
                  </div>

                  <div className="flex flex-col items-end justify-center">
                    <p className="text-[10px]">
                      {money(
                        item.unit_price * item.quantity,
                        order.currency_code
                      )}
                    </p>
                  </div>
                </div>
              )
            })}
          </div>

          {/* TOTALS */}
          <div className="ml-auto mt-8 w-full md:max-w-[440px]">
            <div className="space-y-4 border-b border-[#191816]/20 pb-6">
              <div className="flex items-center justify-between">
                <span className="text-[7px] uppercase tracking-[0.22em] opacity-45">
                  Subtotal
                </span>
                <span className="text-[9px]">
                  {money(order.subtotal, order.currency_code)}
                </span>
              </div>

              {!!order.discount_total && (
                <div className="flex items-center justify-between">
                  <span className="text-[7px] uppercase tracking-[0.22em] opacity-45">
                    Discount
                  </span>
                  <span className="text-[9px]">
                    −{" "}
                    {money(
                      order.discount_total,
                      order.currency_code
                    )}
                  </span>
                </div>
              )}

              {!!order.gift_card_total && (
                <div className="flex items-center justify-between">
                  <span className="text-[7px] uppercase tracking-[0.22em] opacity-45">
                    Gift card
                  </span>
                  <span className="text-[9px]">
                    −{" "}
                    {money(
                      order.gift_card_total,
                      order.currency_code
                    )}
                  </span>
                </div>
              )}

              <div className="flex items-center justify-between">
                <span className="text-[7px] uppercase tracking-[0.22em] opacity-45">
                  Delivery
                </span>
                <span className="text-[9px]">
                  {money(
                    order.shipping_total,
                    order.currency_code
                  )}
                </span>
              </div>

              <div className="flex items-center justify-between">
                <span className="text-[7px] uppercase tracking-[0.22em] opacity-45">
                  Taxes
                </span>
                <span className="text-[9px]">
                  {money(order.tax_total, order.currency_code)}
                </span>
              </div>
            </div>

            <div className="flex items-end justify-between pt-6">
              <span className="text-[8px] uppercase tracking-[0.24em]">
                Total
              </span>

              <span className="font-serif text-[34px] leading-none tracking-[-0.03em]">
                {money(order.total, order.currency_code)}
              </span>
            </div>
          </div>
        </section>

        {/* DELIVERY */}
        <section className="mt-24 md:mt-32">
          <div className="border-b border-[#191816]/25 pb-5">
            <p className="mb-3 text-[8px] uppercase tracking-[0.26em] opacity-40">
              Fulfilment
            </p>

            <h2 className="font-serif text-[40px] font-normal leading-none tracking-[-0.04em] md:text-[54px]">
              Delivery
            </h2>
          </div>

          <div className="grid grid-cols-1 gap-10 border-b border-[#191816]/20 py-8 md:grid-cols-3 md:gap-12">
            <div data-testid="shipping-address-summary">
              <p className="mb-5 text-[7px] uppercase tracking-[0.24em] opacity-35">
                Address
              </p>

              <div className="text-[9px] uppercase leading-[1.8] tracking-[0.12em]">
                <p>
                  {order.shipping_address?.first_name}{" "}
                  {order.shipping_address?.last_name}
                </p>
                <p>{order.shipping_address?.address_1}</p>

                {order.shipping_address?.address_2 && (
                  <p>{order.shipping_address.address_2}</p>
                )}

                <p>
                  {order.shipping_address?.postal_code}{" "}
                  {order.shipping_address?.city}
                </p>

                <p>
                  {order.shipping_address?.country_code?.toUpperCase()}
                </p>
              </div>
            </div>

            <div data-testid="shipping-contact-summary">
              <p className="mb-5 text-[7px] uppercase tracking-[0.24em] opacity-35">
                Contact
              </p>

              <div className="text-[9px] leading-[1.8]">
                <p>{order.email}</p>

                {order.shipping_address?.phone && (
                  <p>{order.shipping_address.phone}</p>
                )}
              </div>
            </div>

            <div data-testid="shipping-method-summary">
              <p className="mb-5 text-[7px] uppercase tracking-[0.24em] opacity-35">
                Method
              </p>

              <div className="text-[9px] uppercase leading-[1.8] tracking-[0.12em]">
                <p>
                  {(shippingMethod as { name?: string })?.name ||
                    "Delivery"}
                </p>

                <p className="opacity-45">
                  {money(
                    shippingMethod?.total ??
                      order.shipping_total,
                    order.currency_code
                  )}
                </p>
              </div>
            </div>
          </div>
        </section>

        {/* EXIT */}
        <section className="mt-20 flex flex-col gap-8 border-t border-[#191816]/25 pt-6 md:mt-28 md:flex-row md:items-end md:justify-between">
          <div>
            <p className="text-[8px] uppercase tracking-[0.26em] opacity-40">
              AYLA / Before Language
            </p>

            <p className="mt-4 max-w-[330px] text-[8px] uppercase leading-[1.8] tracking-[0.15em] opacity-45">
              Thank you for being part of Collection 001.
            </p>
          </div>

          <LocalizedClientLink
            href="/store"
            className="flex h-[56px] w-full items-center justify-between bg-[#191816] px-6 transition-opacity hover:opacity-80 md:w-[280px]"
          >
            <span
              className="text-[8px] uppercase tracking-[0.26em]"
              style={{ color: "#EEEAE1" }}
            >
              Continue shopping
            </span>

            <span
              className="text-[14px]"
              style={{ color: "#EEEAE1" }}
            >
              →
            </span>
          </LocalizedClientLink>
        </section>
      </div>
    </main>
  )
}
